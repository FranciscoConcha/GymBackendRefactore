{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gym": {
    "TimeZone": "America/Santiago"
  },
  "Jwt": { "Issuer": "ucn-gym-api", "Audience": "ucn-gym-frontend" },
  "Reservations": { "MaxDaysAhead": 7, "HorizonUnit": "CalendarDays" },
  "AllowedHosts": "*",
  "Database": {
    "Initialize": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  }
}

