POSTGRES_DB=ucn_gym_review
POSTGRES_USER=gym
POSTGRES_PASSWORD=
JWT_KEY=
QR_SIGNING_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
BOOTSTRAP_ADMIN_RUT=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Puerto local del frontend (en Windows 8080 puede estar reservado por el sistema).
FRONTEND_PORT=8080

ACCOUNTS_FRONTEND_BASE_URL=http://localhost:8080
EMAIL_MODE=Pickup
# Brevo por API: EMAIL_MODE=BrevoApi y EMAIL_API_KEY = clave de API (xkeysib-...), no la clave SMTP.
EMAIL_API_KEY=
EMAIL_FROM_NAME=UCN Gym
EMAIL_PICKUP_DIRECTORY=/app/mail
# Proveedor actual: Brevo (smtp-relay.brevo.com:587, STARTTLS). Usuario = login SMTP de Brevo; contraseña = clave SMTP.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.test
